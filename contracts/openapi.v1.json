            "type": "string"
          },
          "description": {
            "title": "Description",
            "type": "string"
          },
          "entity_ref": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Entity Ref"
          },
          "id": {
            "title": "Id",
