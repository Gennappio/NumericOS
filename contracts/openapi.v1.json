    "/v1/projects": {
      "get": {
        "operationId": "list_projects",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectList"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Resource not found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Request validation failed"
          }
        },
        "summary": "List projects in creation order",
        "tags": [
          "projects"
        ]
      },
      "post": {
        "operationId": "create_project",
        "parameters": [
          {
            "description": "Label of the calling surface, stored on every event it causes.",
            "in": "header",
            "name": "x-actor",
            "required": false,
            "schema": {
              "default": "api:unknown",
              "description": "Label of the calling surface, stored on every event it causes.",
              "pattern": "^[a-z][a-z0-9_-]{0,19}:[A-Za-z0-9_.:-]{1,99}$",
              "title": "X-Actor",
              "type": "string"
            }
