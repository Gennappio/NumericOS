  "info": {
    "title": "NumericOS API",
    "version": "0.0.1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/cards/{card_id}": {
      "get": {
        "operationId": "get_card",
        "parameters": [
          {
            "in": "path",
            "name": "card_id",
            "required": true,
            "schema": {
              "title": "Card Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CardOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Resource not found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Request validation failed"
          }
        },
        "summary": "Get one card",
        "tags": [
          "cards"
        ]
      },
      "patch": {
        "operationId": "update_card",
        "parameters": [
          {
            "in": "path",
            "name": "card_id",
            "required": true,
            "schema": {
              "title": "Card Id",
              "type": "string"
            }
          },
          {
            "description": "Label of the calling surface, stored on every event it causes.",
            "in": "header",
            "name": "x-actor",
            "required": false,
            "schema": {
              "default": "api:unknown",
              "description": "Label of the calling surface, stored on every event it causes.",
              "pattern": "^[a-z][a-z0-9_-]{0,19}:[A-Za-z0-9_.:-]{1,99}$",
              "title": "X-Actor",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CardPatch"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CardOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Resource not found"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Stale version or project mismatch"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Request validation failed"
          }
        },
        "summary": "Edit and/or move a card (requires its current version)",
        "tags": [
          "cards"
        ]
      }
    },
    "/v1/events": {
      "get": {
        "operationId": "list_events",
        "parameters": [
          {
            "description": "Project whose ledger is read.",
            "in": "query",
            "name": "project_id",
            "required": true,
            "schema": {
              "description": "Project whose ledger is read.",
              "title": "Project Id",
              "type": "string"
            }
          },
          {
            "description": "Cursor: only events with seq greater than this.",
            "in": "query",
            "name": "after",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "minimum": 0,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Cursor: only events with seq greater than this.",
              "title": "After"
            }
          },
          {
            "description": "Only events with seq lower than this. JSON only.",
            "in": "query",
            "name": "before",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "minimum": 1,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Only events with seq lower than this. JSON only.",
              "title": "Before"
            }
          },
          {
            "description": "Page size, default 100. JSON only.",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maximum": 1000,
                  "minimum": 1,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Page size, default 100. JSON only.",
              "title": "Limit"
            }
          },
          {
            "description": "Ordering by seq. A stream is always asc.",
            "in": "query",
            "name": "order",
            "required": false,
            "schema": {
              "default": "asc",
              "description": "Ordering by seq. A stream is always asc.",
              "enum": [
                "asc",
                "desc"
              ],
              "title": "Order",
              "type": "string"
            }
          },
          {
            "description": "Sent by EventSource clients when they reconnect to a stream.",
            "in": "header",
            "name": "last-event-id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "pattern": "^\\d{1,18}$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Sent by EventSource clients when they reconnect to a stream.",
              "title": "Last-Event-Id"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventPage"
                }
              },
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "A page of events as JSON. With `Accept: text/event-stream` the response is a Server-Sent Events stream instead: it replays every event after the cursor in `seq` order, then follows the ledger. Each frame has `id: <seq>` and the event as JSON in `data`; reconnecting with `Last-Event-ID` resumes after that event."
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Resource not found"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Stale version or project mismatch"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Request validation failed"
          }
        },
        "summary": "Read a project's event ledger by cursor (JSON page or SSE stream)",
        "tags": [
          "events"
        ]
      }
    },
